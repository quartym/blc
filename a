-- PROFİL AÇMA FONKSİYONU
----------------------------------------------------------------
local function openPlayerProfile(userId)
	local url = "https://www.roblox.com/users/" .. tostring(userId) .. "/profile"
	local ok, err = pcall(function()
		GuiService:OpenBrowserWindow(url)
	end)
	if not ok then
		warn("Profil sayfası açılamadı: " .. tostring(err))
	end
end

----------------------------------------------------------------
-- OYUNCU KARTI OLUŞTURMA
----------------------------------------------------------------
local playerCards = {} -- [Player] = Frame

local function createPlayerCard(player)
	local card = Instance.new("TextButton")
	card.Name = "Card_" .. player.Name
	card.Size = UDim2.new(1, 0, 0, 64)
	card.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
	card.AutoButtonColor = false
	card.Text = ""
	card.LayoutOrder = player.UserId
	card.Parent = scrollFrame

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 10)
	cardCorner.Parent = card

	-- Hover efekti
	card.MouseEnter:Connect(function()
		TweenService:Create(card, TweenInfo.new(0.12), {
			BackgroundColor3 = Color3.fromRGB(50, 50, 64)
		}):Play()
	end)
	card.MouseLeave:Connect(function()
		TweenService:Create(card, TweenInfo.new(0.12), {
			BackgroundColor3 = Color3.fromRGB(38, 38, 48)
		}):Play()
	end)

	-- Avatar thumbnail
	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.AnchorPoint = Vector2.new(0, 0.5)
	avatar.Position = UDim2.new(0, 8, 0.5, 0)
	avatar.Size = UDim2.new(0, 48, 0, 48)
	avatar.BackgroundColor3 = Color3.fromRGB(60, 60, 74)
	avatar.Image = ""
	avatar.Parent = card

	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(1, 0)
	avatarCorner.Parent = avatar

	-- Thumbnail'i asenkron yükle (UI'yı bloklamamak için)
	task.spawn(function()
		local ok, content, isReady = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, THUMBNAIL_TYPE, THUMBNAIL_SIZE)
		end)
		if ok and content then
			avatar.Image = content
		end
	end)

	-- Metin konteyneri (isimler burada, uzun isimler taşmasın diye ayrı frame)
	local textHolder = Instance.new("Frame")
	textHolder.Name = "TextHolder"
	textHolder.BackgroundTransparency = 1
	textHolder.AnchorPoint = Vector2.new(0, 0.5)
	textHolder.Position = UDim2.new(0, 66, 0.5, 0)
	textHolder.Size = UDim2.new(1, -76, 1, -10)
	textHolder.Parent = card

	local displayNameLabel = Instance.new("TextLabel")
	displayNameLabel.Name = "DisplayName"
	displayNameLabel.BackgroundTransparency = 1
	displayNameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	displayNameLabel.Font = Enum.Font.GothamBold
	displayNameLabel.Text = player.DisplayName
	displayNameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	displayNameLabel.TextSize = 15
	displayNameLabel.TextXAlignment = Enum.TextXAlignment.Left
	displayNameLabel.TextYAlignment = Enum.TextYAlignment.Bottom
	displayNameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	displayNameLabel.Parent = textHolder

	local usernameLabel = Instance.new("TextLabel")
	usernameLabel.Name = "Username"
	usernameLabel.BackgroundTransparency = 1
	usernameLabel.Position = UDim2.new(0, 0, 0.5, 0)
	usernameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	usernameLabel.Font = Enum.Font.Gotham
	usernameLabel.Text = "@" .. player.Name
	usernameLabel.TextColor3 = Color3.fromRGB(170, 170, 185)
	usernameLabel.TextSize = 13
	usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
	usernameLabel.TextYAlignment = Enum.TextYAlignment.Top
	usernameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	usernameLabel.Parent = textHolder

	-- Tıklama -> profil aç (kendi ismine tıklamak da dahil)
	card.MouseButton1Click:Connect(function()
		openPlayerProfile(player.UserId)
	end)

	return card
end

----------------------------------------------------------------
-- LİSTE YÖNETİMİ
----------------------------------------------------------------
local function addPlayer(player)
	if playerCards[player] then return end
	local card = createPlayerCard(player)
	playerCards[player] = card
end

local function removePlayer(player)
	local card = playerCards[player]
	if card then
		card:Destroy()
		playerCards[player] = nil
	end
end

-- Menü açıldığı anda mevcut TÜM oyuncuları listele
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end

-- Yeni oyuncu girince otomatik ekle
Players.PlayerAdded:Connect(addPlayer)

-- Oyuncu çıkınca otomatik sil
Players.PlayerRemoving:Connect(removePlayer)

-- DisplayName değişirse (nadir de olsa) etiketi güncelle
Players.PlayerAdded:Connect(function(player)
	player:GetPropertyChangedSignal("DisplayName"):Connect(function()
		local card = playerCards[player]
		if card then
			local textHolder = card:FindFirstChild("TextHolder")
			if textHolder then
				local label = textHolder:FindFirstChild("DisplayName")
				if label then
					label.Text = player.DisplayName
				end
			end
		end
	end)
end)
