-- AÇMA / KAPAMA MANTIĞI
----------------------------------------------------------------
local isOpen = false

local function setMenuOpen(open)
	isOpen = open
	if open then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 320, 0, 0)
		local targetSize = UDim2.new(0, 320, 0.65, 0)
		TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = targetSize
		}):Play()
	else
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 320, 0, 0)
		})
		tween:Play()
		tween.Completed:Connect(function()
			if not isOpen then
				mainFrame.Visible = false
			end
		end)
	end
end

toggleButton.MouseButton1Click:Connect(function()
	setMenuOpen(not isOpen)
end)

closeButton.MouseButton1Click:Connect(function()
	setMenuOpen(false)
end)

