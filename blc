local function getThumbnail(userId)
	local success, content = pcall(function()
		return Players:GetUserThumbnailAsync(
			userId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size100x100
		)
	end)

	if success then
		return content
	end

	return ""
end

--==================================================
-- OPEN PROFILE
--==================================================

local function openPlayerProfile(player)
	if not player or not player:IsDescendantOf(Players) then
		return
	end

	-- Roblox player profile URL
	local profileUrl = "https://www.roblox.com/users/" .. tostring(player.UserId) .. "/profile"

	-- Open the Roblox profile in the browser.
	pcall(function()
		GuiService:OpenBrowserWindow(profileUrl)
	end)
end

--==================================================
-- CREATE PLAYER ROW
--==================================================

local function createPlayerRow(player)
	local row = Instance.new("TextButton")
	row.Name = "Player_" .. tostring(player.UserId)
	row.Parent = scrollingFrame

	row.Size = UDim2.new(1, -4, 0, 70)

	row.BackgroundColor3 = Color3.fromRGB(32, 32, 39)
	row.BorderSizePixel = 0

	row.AutoButtonColor = false

	row.Text = ""

	-- Prevent weird name/ID characters from affecting layout.
	row.ClipsDescendants = true

	local rowCorner = Instance.new("UICorner")
	rowCorner.CornerRadius = UDim.new(0, 10)
	rowCorner.Parent = row

	--==================================================
	-- THUMBNAIL
	--==================================================

	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.Parent = row

	avatar.Position = UDim2.fromOffset(8, 8)
	avatar.Size = UDim2.fromOffset(54, 54)

	avatar.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	avatar.BorderSizePixel = 0

	avatar.Image = getThumbnail(player.UserId)
	avatar.ScaleType = Enum.ScaleType.Crop

	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(1, 0)
	avatarCorner.Parent = avatar

	--==================================================
	-- DISPLAY NAME
	--==================================================

	local displayName = Instance.new("TextLabel")
	displayName.Name = "DisplayName"
	displayName.Parent = row

	displayName.Position = UDim2.fromOffset(72, 11)
	displayName.Size = UDim2.new(1, -92, 0, 24)

	displayName.BackgroundTransparency = 1

	displayName.Font = Enum.Font.GothamBold
	displayName.Text = player.DisplayName
	displayName.TextColor3 = Color3.fromRGB(245, 245, 248)
	displayName.TextSize = 15

	displayName.TextXAlignment = Enum.TextXAlignment.Left
	displayName.TextYAlignment = Enum.TextYAlignment.Center

	displayName.TextTruncate = Enum.TextTruncate.AtEnd

	--==================================================
	-- USERNAME
	--==================================================

	local username = Instance.new("TextLabel")
	username.Name = "Username"
	username.Parent = row

	username.Position = UDim2.fromOffset(72, 36)
	username.Size = UDim2.new(1, -92, 0, 20)

	username.BackgroundTransparency = 1

	username.Font = Enum.Font.Gotham
	username.Text = "@" .. player.Name
	username.TextColor3 = Color3.fromRGB(145, 145, 155)
	username.TextSize = 12

	username.TextXAlignment = Enum.TextXAlignment.Left
	username.TextYAlignment = Enum.TextYAlignment.Center

	username.TextTruncate = Enum.TextTruncate.AtEnd

	--==================================================
	-- CLICK
	--==================================================

	row.Activated:Connect(function()
		openPlayerProfile(player)
	end)

	--==================================================
	-- HOVER
	--==================================================

	row.MouseEnter:Connect(function()
		row.BackgroundColor3 = Color3.fromRGB(42, 42, 50)
	end)

	row.MouseLeave:Connect(function()
		row.BackgroundColor3 = Color3.fromRGB(32, 32, 39)
	end)

	return row
end

--==================================================
-- REFRESH PLAYER LIST
--==================================================

local function refreshPlayerList()
	-- Delete old rows.
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	-- Get everyone currently in the server.
	local players = Players:GetPlayers()

	-- Update counter.
	playerCount.Text = tostring(#players) .. " players in this server"

	-- Create a row for every player.
	for _, player in ipairs(players) do
		createPlayerRow(player)
	end
end

--==================================================
-- PLAYER JOIN
--==================================================

Players.PlayerAdded:Connect(function(player)
	-- Wait briefly so the player is completely initialized.
	task.defer(function()
		if player:IsDescendantOf(Players) then
			refreshPlayerList()
		end
	end)
end)

--==================================================
-- PLAYER LEAVE
--==================================================

Players.PlayerRemoving:Connect(function(player)
	task.defer(function()
		refreshPlayerList()
	end)
end)

--==================================================
-- OPEN / CLOSE
--==================================================

closeButton.Activated:Connect(function()
	mainFrame.Visible = false
	openButton.Visible = true
end)

openButton.Activated:Connect(function()
	mainFrame.Visible = true

	-- Refresh every time the menu opens.
	refreshPlayerList()
end)

--==================================================
-- INITIAL STATE
--==================================================

mainFrame.Visible = false
openButton.Visible = true

-- Build the initial list.
refreshPlayerList()
