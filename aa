--------------------------------------------------
-- CREATE PLAYER BUTTON
--------------------------------------------------

local function CreatePlayerButton(Player)

	-- Aynı oyuncu zaten varsa oluşturma
	if List:FindFirstChild("Player_" .. Player.UserId) then
		return
	end

	local Button = Instance.new("TextButton")
	Button.Name = "Player_" .. Player.UserId
	Button.Size = UDim2.new(1, -5, 0, 68)
	Button.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
	Button.BorderSizePixel = 0
	Button.Text = ""
	Button.AutoButtonColor = true
	Button.LayoutOrder = Player.UserId
	Button.Parent = List

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0, 10)
	ButtonCorner.Parent = Button

	--------------------------------------------------
	-- AVATAR
	--------------------------------------------------

	local Avatar = Instance.new("ImageLabel")
	Avatar.Name = "Avatar"
	Avatar.Size = UDim2.fromOffset(52, 52)
	Avatar.Position = UDim2.fromOffset(8, 8)
	Avatar.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
	Avatar.BorderSizePixel = 0
	Avatar.Image = ""
	Avatar.Parent = Button

	local AvatarCorner = Instance.new("UICorner")
	AvatarCorner.CornerRadius = UDim.new(1, 0)
	AvatarCorner.Parent = Avatar

	task.spawn(function()

		local Success, Image = pcall(function()

			return Players:GetUserThumbnailAsync(
				Player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)

		end)

		if Success and Image and Avatar.Parent then
			Avatar.Image = Image
		end

	end)

	--------------------------------------------------
	-- DISPLAY NAME
	--------------------------------------------------

	local DisplayName = Instance.new("TextLabel")
	DisplayName.Size = UDim2.new(1, -75, 0, 26)
	DisplayName.Position = UDim2.fromOffset(70, 8)
	DisplayName.BackgroundTransparency = 1
	DisplayName.Text = Player.DisplayName
	DisplayName.TextColor3 = Color3.fromRGB(255, 255, 255)
	DisplayName.TextSize = 15
	DisplayName.Font = Enum.Font.GothamBold
	DisplayName.TextXAlignment = Enum.TextXAlignment.Left
	DisplayName.TextTruncate = Enum.TextTruncate.AtEnd
	DisplayName.Parent = Button

	--------------------------------------------------
	-- USERNAME
	--------------------------------------------------

	local Username = Instance.new("TextLabel")
	Username.Size = UDim2.new(1, -75, 0, 23)
	Username.Position = UDim2.fromOffset(70, 34)
	Username.BackgroundTransparency = 1
	Username.Text = "@" .. Player.Name
	Username.TextColor3 = Color3.fromRGB(145, 145, 155)
	Username.TextSize = 12
	Username.Font = Enum.Font.Gotham
	Username.TextXAlignment = Enum.TextXAlignment.Left
	Username.TextTruncate = Enum.TextTruncate.AtEnd
	Username.Parent = Button

	--------------------------------------------------
	-- CLICK
	--------------------------------------------------

	Button.MouseButton1Click:Connect(function()

		local UserId = Player.UserId

		local ProfileURL =
			"https://www.roblox.com/users/"
			.. tostring(UserId)
			.. "/profile"

		ProfileTitle.Text = Player.DisplayName .. "'s Profile"
		URLBox.Text = ProfileURL

		ProfileFrame.Visible = true

		task.defer(function()

			if URLBox.Parent then

				URLBox:CaptureFocus()

				URLBox.SelectionStart = 1
				URLBox.CursorPosition = #ProfileURL + 1

			end

		end)

	end)

end

--------------------------------------------------
-- REMOVE PLAYER
--------------------------------------------------

local function RemovePlayer(Player)

	local Button = List:FindFirstChild("Player_" .. Player.UserId)

	if Button then
		Button:Destroy()
	end

end

--------------------------------------------------
-- UPDATE COUNT
--------------------------------------------------

local function UpdateCount()

	local Amount = #Players:GetPlayers()

	if Amount == 1 then
		Count.Text = "1 player"
	else
		Count.Text = tostring(Amount) .. " players"
	end

end

--------------------------------------------------
-- INITIAL PLAYERS
--------------------------------------------------

for _, Player in ipairs(Players:GetPlayers()) do

	CreatePlayerButton(Player)

end

UpdateCount()

--------------------------------------------------
-- PLAYER JOIN
--------------------------------------------------

Players.PlayerAdded:Connect(function(Player)

	CreatePlayerButton(Player)
	UpdateCount()

end)

--------------------------------------------------
-- PLAYER LEAVE
--------------------------------------------------

Players.PlayerRemoving:Connect(function(Player)

	RemovePlayer(Player)
	UpdateCount()

end)

--------------------------------------------------
-- OPEN / CLOSE
--------------------------------------------------

OpenButton.MouseButton1Click:Connect(function()

	Main.Visible = not Main.Visible

end)

Close.MouseButton1Click:Connect(function()

	Main.Visible = false

end)

--------------------------------------------------
-- PROFILE CLOSE
--------------------------------------------------

ProfileClose.MouseButton1Click:Connect(function()

	ProfileFrame.Visible = false
	URLBox:ReleaseFocus()

end)

--------------------------------------------------
-- SELECT LINK
--------------------------------------------------

CopyButton.MouseButton1Click:Connect(function()

	URLBox:CaptureFocus()

	URLBox.SelectionStart = 1
	URLBox.CursorPosition = #URLBox.Text + 1

	CopyButton.Text = "LINK SELECTED"

	task.delay(1.5, function()

		if CopyButton.Parent then
			CopyButton.Text = "SELECT LINK"
		end

	end)

end)

