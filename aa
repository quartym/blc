-- ============================================================
-- AÇ / KAPAT MANTIĞI
-- ============================================================
local isOpen = false

local function setOpen(open)
    isOpen = open
    mainFrame.Visible = open
    if not open then
        linkBox.Visible = false
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setOpen(not isOpen)
end)

-- ============================================================
-- BİLDİRİM GÖSTERME (kısa süreli mesaj)
-- ============================================================
local notifyToken = 0

local function showNotification(text)
    notifyToken += 1
    local myToken = notifyToken

    notifyLabel.Text = text
    notifyLabel.TextTransparency = 0

    task.delay(2, function()
        if myToken ~= notifyToken then
            return -- daha yeni bir bildirim geldi, bunu iptal et
        end
        local tween = TweenService:Create(
            notifyLabel,
            TweenInfo.new(0.4, Enum.EasingStyle.Quad),
            { TextTransparency = 1 }
        )
        tween:Play()
    end)
end

-- ============================================================
-- PROFİL LİNKİ GÖSTERME + SEÇME (kopyalama yerine geçen güvenli yöntem)
-- ============================================================
local function presentProfileLink(url)
    linkBox.Text = url
    linkBox.Visible = true

    -- Kullanıcıya kolayca seçip Ctrl+C yapabilmesi için odaklan ve tüm metni seç
    linkBox:CaptureFocus()
    linkBox.CursorPosition = #url + 1
    linkBox.SelectionStart = 1

    showNotification("Profile link ready — press Ctrl+C to copy")
end

-- ============================================================
-- OYUNCU SATIRI OLUŞTURMA
-- ============================================================
local playerEntries = {} -- [Player] = Frame

local function createPlayerEntry(targetPlayer)
    local entry = Instance.new("TextButton")
    entry.Name = "Entry_" .. tostring(targetPlayer.UserId)
    entry.Parent = scrollFrame
    entry.Size = UDim2.new(1, 0, 0, ENTRY_HEIGHT)
    entry.BackgroundColor3 = THEME.EntryBg
    entry.AutoButtonColor = false
    entry.Text = ""
    entry.LayoutOrder = targetPlayer.UserId

    local entryCorner = Instance.new("UICorner")
    entryCorner.CornerRadius = UDim.new(0, 10)
    entryCorner.Parent = entry

    -- Avatar thumbnail
    local avatar = Instance.new("ImageLabel")
    avatar.Name = "Avatar"
    avatar.Parent = entry
    avatar.Size = UDim2.new(0, 40, 0, 40)
    avatar.Position = UDim2.new(0, 8, 0.5, -20)
    avatar.BackgroundColor3 = THEME.Panel
    avatar.Image = ""

    local avatarCorner = Instance.new("UICorner")
    avatarCorner.CornerRadius = UDim.new(1, 0)
    avatarCorner.Parent = avatar

    -- Display Name
    local displayLabel = Instance.new("TextLabel")
    displayLabel.Name = "DisplayName"
    displayLabel.Parent = entry
    displayLabel.Size = UDim2.new(1, -60, 0, 20)
    displayLabel.Position = UDim2.new(0, 56, 0, 6)
    displayLabel.BackgroundTransparency = 1
    displayLabel.Text = targetPlayer.DisplayName
    displayLabel.TextColor3 = THEME.Text
    displayLabel.TextSize = 14
    displayLabel.Font = Enum.Font.GothamBold
    displayLabel.TextXAlignment = Enum.TextXAlignment.Left
    displayLabel.TextTruncate = Enum.TextTruncate.AtEnd

    -- Kullanıcı adı (@username) — boşluk/özel karakter olsa da doğrudan
    -- Text özelliğine atandığı için sorun çıkmaz.
    local usernameLabel = Instance.new("TextLabel")
    usernameLabel.Name = "Username"
    usernameLabel.Parent = entry
    usernameLabel.Size = UDim2.new(1, -60, 0, 16)
    usernameLabel.Position = UDim2.new(0, 56, 0, 26)
    usernameLabel.BackgroundTransparency = 1
    usernameLabel.Text = "@" .. targetPlayer.Name
    usernameLabel.TextColor3 = THEME.SubText
    usernameLabel.TextSize = 12
    usernameLabel.Font = Enum.Font.Gotham
    usernameLabel.TextXAlignment = Enum.TextXAlignment.Left
    usernameLabel.TextTruncate = Enum.TextTruncate.AtEnd

    -- Hover efekti
    entry.MouseEnter:Connect(function()
        entry.BackgroundColor3 = THEME.EntryBgHover
    end)
    entry.MouseLeave:Connect(function()
        entry.BackgroundColor3 = THEME.EntryBg
    end)

    -- Tıklama: profil linkini oluştur ve göster
    entry.MouseButton1Click:Connect(function()
        local url = string.format("https://www.roblox.com/users/%d/profile", targetPlayer.UserId)
        presentProfileLink(url)
    end)

    -- Avatar thumbnail'ini ayrı bir task içinde yükle (listeyi bloklamasın)
    task.spawn(function()
        local ok, content = pcall(function()
            local thumb = Players:GetUserThumbnailAsync(
                targetPlayer.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
            return thumb
        end)
        if ok and content and avatar.Parent then
            avatar.Image = content
        end
    end)

    playerEntries[targetPlayer] = entry
end

local function removePlayerEntry(targetPlayer)
    local entry = playerEntries[targetPlayer]
    if entry then
        entry:Destroy()
        playerEntries[targetPlayer] = nil
    end
end

local function updateCountLabel()
    local count = 0
    for _ in pairs(playerEntries) do
        count += 1
    end
    countLabel.Text = tostring(count) .. " online"
end

-- ============================================================
-- OYUNCU EVENT'LERİ
-- ============================================================
for _, p in ipairs(Players:GetPlayers()) do
    createPlayerEntry(p)
end
updateCountLabel()

Players.PlayerAdded:Connect(function(p)
    createPlayerEntry(p)
    updateCountLabel()
end)

Players.PlayerRemoving:Connect(function(p)
    removePlayerEntry(p)
    updateCountLabel()
end)
