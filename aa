-- Oyuncu oluştur
local function addPlayer(targetPlayer)

	local button = Instance.new("TextButton")
	button.Name = targetPlayer.Name
	button.Size = UDim2.new(1, -5, 0, 60)
	button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	button.BorderSizePixel = 0
	button.Text = ""
	button.Parent = list

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 8)
	buttonCorner.Parent = button

	-- Avatar
	local avatar = Instance.new("ImageLabel")
	avatar.Size = UDim2.new(0, 45, 0, 45)
	avatar.Position = UDim2.new(0, 7, 0.5, -22)
	avatar.BackgroundTransparency = 1
	avatar.Parent = button

	local success, image = pcall(function()
		return Players:GetUserThumbnailAsync(
			targetPlayer.UserId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size100x100
		)
	end)

	if success then
		avatar.Image = image
	end

	-- Display name
	local display = Instance.new("TextLabel")
	display.Size = UDim2.new(1, -65, 0, 25)
	display.Position = UDim2.new(0, 60, 0, 5)
	display.BackgroundTransparency = 1
	display.Text = targetPlayer.DisplayName
	display.TextColor3 = Color3.new(1, 1, 1)
	display.TextSize = 15
	display.Font = Enum.Font.GothamBold
	display.TextXAlignment = Enum.TextXAlignment.Left
	display.Parent = button

	-- Username
	local username = Instance.new("TextLabel")
	username.Size = UDim2.new(1, -65, 0, 22)
	username.Position = UDim2.new(0, 60, 0, 30)
	username.BackgroundTransparency = 1
	username.Text = "@" .. targetPlayer.Name
	username.TextColor3 = Color3.fromRGB(150, 150, 150)
	username.TextSize = 12
	username.Font = Enum.Font.Gotham
	username.TextXAlignment = Enum.TextXAlignment.Left
	username.Parent = button

	-- Tıklayınca profil linki
	button.MouseButton1Click:Connect(function()

		local url = "https://www.roblox.com/users/"
			.. targetPlayer.UserId
			.. "/profile"

		print("Profil:", url)

		linkTitle.Text = targetPlayer.DisplayName .. " Profile"
		linkBox.Text = url
		linkFrame.Visible = true

		task.wait()

		linkBox:CaptureFocus()
		linkBox.CursorPosition = #url + 1
	end)
end

-- Mevcut oyuncular
for _, targetPlayer in ipairs(Players:GetPlayers()) do
	addPlayer(targetPlayer)
end

-- Yeni oyuncu
Players.PlayerAdded:Connect(function(targetPlayer)
	addPlayer(targetPlayer)
end)

-- Çıkan oyuncu
Players.PlayerRemoving:Connect(function(targetPlayer)

	local button = list:FindFirstChild(targetPlayer.Name)

	if button then
		button:Destroy()
	end
end)
