local function refresh()
	for _, child in ipairs(List:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local players = Players:GetPlayers()

	Count.Text = #players .. " players in this server"

	for _, player in ipairs(players) do
		createRow(player)
	end
end

