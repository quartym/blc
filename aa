--[[
    PlayerListGui - LocalScript
    Konum: StarterGui > PlayerListGui (ScreenGui) > LocalScript

    Özellikler:
    - Aç/kapat edilebilir oyuncu listesi
    - Kullanıcı adı, display name, avatar thumbnail
    - Oyuncu girince/çıkınca otomatik güncelleme
    - Tıklayınca profil URL'sini gösterme (gerçek clipboard yazma API'si
      Roblox oyun ortamında LocalScript'ler için mevcut değildir; bu yüzden
      URL, seçili bir TextBox içinde gösterilir ve oyuncu Ctrl+C ile
      kopyalayabilir. Bu, uydurma bir API kullanmamak için bilinçli bir tercihtir.)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
