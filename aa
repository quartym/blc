--==================================================
-- OYUNCU BUTONU OLUŞTURMA
--==================================================

local function createPlayerButton(player)

	local button = create("TextButton", {
		Name = player.Name,
		Size = UDim2.new(1, -5, 0, 62),
		BackgroundColor3 = Color3.fromRGB(32, 32, 38),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = true,
	}, playerList)

	create("UICorner", {
		CornerRadius = UDim.new(0, 10)
	}, button)

	-- Avatar
	local avatar = create("ImageLabel", {
		Name = "Avatar",
		Size = UDim2.new(0, 48, 0, 48),
		Position = UDim2.new(0, 7, 0.5, -24),
		BackgroundColor3 = Color3.fromRGB(45, 45, 50),
		BorderSizePixel = 0,
		Image = "",
	}, button)

	create("UICorner", {
		CornerRadius = UDim.new(1, 0)
	}, avatar)

	-- Avatar thumbnail
	task.spawn(function()

		local success, image = pcall(function()
			return Players:GetUserThumbnailAsync(
				player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)

		if success and image then
			avatar.Image = image
		end
	end)

	-- Display Name
	local displayName = create("TextLabel", {
		Name = "DisplayName",
		Size = UDim2.new(1, -75, 0, 25),
		Position = UDim2.new(0, 65, 0, 8),
		BackgroundTransparency = 1,
		Text = player.DisplayName,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 15,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, button)

	-- Username
	local username = create("TextLabel", {
		Name = "Username",
		Size = UDim2.new(1, -75, 0, 22),
		Position = UDim2.new(0, 65, 0, 31),
		BackgroundTransparency = 1,
		Text = "@" .. player.Name,
		TextColor3 = Color3.fromRGB(145, 145, 150),
		TextSize = 12,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, button)

	-- Tıklama
	button.MouseButton1Click:Connect(function()

		local profileUrl = "https://www.roblox.com/users/"
			.. tostring(player.UserId)
			.. "/profile"

		linkBox.Text = profileUrl
		linkTitle.Text = player.DisplayName .. "'s Profile"
		linkFrame.Visible = true

		-- TextBox'a otomatik odaklan
		task.defer(function()
			linkBox:CaptureFocus()
			linkBox.CursorPosition = #linkBox.Text + 1
		end)
	end)

	return button
end

--==================================================
-- LİSTEYİ YENİLE
--==================================================

local function updateCount()

	local count = #Players:GetPlayers()

	if count == 1 then
		countLabel.Text = "1 player"
	else
		countLabel.Text = tostring(count) .. " players"
	end
end

local function refreshPlayers()

	-- Eski butonları temizle
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	-- Oyuncuları ekle
	for _, player in ipairs(Players:GetPlayers()) do
		createPlayerButton(player)
	end

	updateCount()
end

--==================================================
-- PLAYER EVENTS
--==================================================

Players.PlayerAdded:Connect(function(player)

	createPlayerButton(player)
	updateCount()

end)

Players.PlayerRemoving:Connect(function(player)

	local button = playerList:FindFirstChild(player.Name)

	if button then
		button:Destroy()
	end

	updateCount()
end)

