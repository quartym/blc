local SelectedPlayer = nil

--==================================================
-- SHOW PLAYER INFO
--==================================================

local function showPlayerInfo(player)

	if not player then
		return
	end

	SelectedPlayer = player

	local userId = tostring(player.UserId)

	local profileLink =
		"https://www.roblox.com/users/"
		.. userId
		.. "/profile"

	UserIdLabel.Text = "UserId: " .. userId

	ProfileBox.Text = profileLink

	Info.Visible = true
	Main.Visible = false

end

--==================================================
-- CREATE PLAYER ROW
--==================================================

local function createPlayerRow(player)

	local Row = Instance.new("TextButton")

	Row.Name = "Player_" .. tostring(player.UserId)

	Row.Parent = List

	Row.Size = UDim2.new(1, -4, 0, 68)

	Row.BackgroundColor3 = Color3.fromRGB(32, 32, 39)

	Row.BorderSizePixel = 0

	Row.Text = ""

	Row.AutoButtonColor = false

	Row.ClipsDescendants = true

	--==================================================
	-- AVATAR
	--==================================================

	local Avatar = Instance.new("ImageLabel")

	Avatar.Parent = Row

	Avatar.Position = UDim2.fromOffset(8, 7)

	Avatar.Size = UDim2.fromOffset(54, 54)

	Avatar.BackgroundColor3 = Color3.fromRGB(45, 45, 52)

	Avatar.BorderSizePixel = 0

	Avatar.Image = getThumbnail(player.UserId)

	Avatar.ScaleType = Enum.ScaleType.Crop

	local AvatarCorner = Instance.new("UICorner")

	AvatarCorner.CornerRadius = UDim.new(1, 0)

	AvatarCorner.Parent = Avatar

	--==================================================
	-- DISPLAY NAME
	--==================================================

	local Display = Instance.new("TextLabel")

	Display.Parent = Row

	Display.Position = UDim2.fromOffset(72, 10)

	Display.Size = UDim2.new(1, -90, 0, 23)

	Display.BackgroundTransparency = 1

	Display.Font = Enum.Font.GothamBold

	Display.Text = player.DisplayName

	Display.TextColor3 = Color3.fromRGB(245, 245, 248)

	Display.TextSize = 15

	Display.TextXAlignment = Enum.TextXAlignment.Left

	Display.TextTruncate = Enum.TextTruncate.AtEnd

	--==================================================
	-- USERNAME
	--==================================================

	local Username = Instance.new("TextLabel")

	Username.Parent = Row

	Username.Position = UDim2.fromOffset(72, 35)

	Username.Size = UDim2.new(1, -90, 0, 20)

	Username.BackgroundTransparency = 1

	Username.Font = Enum.Font.Gotham

	Username.Text = "@" .. player.Name

	Username.TextColor3 = Color3.fromRGB(145, 145, 155)

	Username.TextSize = 12

	Username.TextXAlignment = Enum.TextXAlignment.Left

	Username.TextTruncate = Enum.TextTruncate.AtEnd

	--==================================================
	-- CLICK
	--==================================================

	Row.Activated:Connect(function()

		showPlayerInfo(player)

	end)

	--==================================================
	-- HOVER
	--==================================================

	Row.MouseEnter:Connect(function()

		Row.BackgroundColor3 = Color3.fromRGB(43, 43, 51)

	end)

	Row.MouseLeave:Connect(function()

		Row.BackgroundColor3 = Color3.fromRGB(32, 32, 39)

	end)

end

--==================================================
-- REFRESH
--==================================================

local function refreshPlayers()

	for _, child in ipairs(List:GetChildren()) do

		if child:IsA("TextButton") then

			child:Destroy()

		end

	end

	local currentPlayers = Players:GetPlayers()

	Count.Text =
		tostring(#currentPlayers)
		.. " players in this server"

	for _, player in ipairs(currentPlayers) do

		createPlayerRow(player)

	end

end

