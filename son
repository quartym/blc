--==================================================
-- PLAYER CARD
--==================================================

local function CreatePlayerButton(Player)

	if List:FindFirstChild("Player_" .. Player.UserId) then
		return
	end

	local Button = Instance.new("TextButton")
	Button.Name = "Player_" .. Player.UserId
	Button.Size = UDim2.new(1, -3, 0, 64)
	Button.BackgroundColor3 = COLORS.Card
	Button.BorderSizePixel = 0
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.LayoutOrder = Player.UserId
	Button.Parent = List

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0, 11)
	ButtonCorner.Parent = Button

	-- Avatar
	local Avatar = Instance.new("ImageLabel")
	Avatar.Size = UDim2.fromOffset(48, 48)
	Avatar.Position = UDim2.fromOffset(8, 8)
	Avatar.BackgroundColor3 = Color3.fromRGB(40, 41, 48)
	Avatar.BorderSizePixel = 0
	Avatar.Image = ""
	Avatar.Parent = Button

	local AvatarCorner = Instance.new("UICorner")
	AvatarCorner.CornerRadius = UDim.new(1, 0)
	AvatarCorner.Parent = Avatar

	-- Avatar çizgisi
	local AvatarStroke = Instance.new("UIStroke")
	AvatarStroke.Color = Color3.fromRGB(60, 62, 75)
	AvatarStroke.Thickness = 1
	AvatarStroke.Parent = Avatar

	-- Display Name
	local DisplayName = Instance.new("TextLabel")
	DisplayName.Size = UDim2.new(1, -85, 0, 24)
	DisplayName.Position = UDim2.fromOffset(68, 9)
	DisplayName.BackgroundTransparency = 1
	DisplayName.Text = Player.DisplayName
	DisplayName.TextColor3 = COLORS.Text
	DisplayName.TextSize = 14
	DisplayName.Font = Enum.Font.GothamBold
	DisplayName.TextXAlignment = Enum.TextXAlignment.Left
	DisplayName.TextTruncate = Enum.TextTruncate.AtEnd
	DisplayName.Parent = Button

	-- Username
	local Username = Instance.new("TextLabel")
	Username.Size = UDim2.new(1, -85, 0, 20)
	Username.Position = UDim2.fromOffset(68, 33)
	Username.BackgroundTransparency = 1
	Username.Text = "@" .. Player.Name
	Username.TextColor3 = COLORS.SubText
	Username.TextSize = 11
	Username.Font = Enum.Font.Gotham
	Username.TextXAlignment = Enum.TextXAlignment.Left
	Username.TextTruncate = Enum.TextTruncate.AtEnd
	Username.Parent = Button

	-- Sağdaki ok
	local Arrow = Instance.new("TextLabel")
	Arrow.Size = UDim2.fromOffset(20, 30)
	Arrow.Position = UDim2.new(1, -28, 0.5, -15)
	Arrow.BackgroundTransparency = 1
	Arrow.Text = "›"
	Arrow.TextColor3 = Color3.fromRGB(100, 103, 115)
	Arrow.TextSize = 22
	Arrow.Font = Enum.Font.GothamBold
	Arrow.Parent = Button

	-- Avatar yükle
	task.spawn(function()

		local Success, Image = pcall(function()

			return Players:GetUserThumbnailAsync(
				Player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)

		end)

		if Success and Image and Avatar.Parent then
			Avatar.Image = Image
		end

	end)

	-- Hover
	Button.MouseEnter:Connect(function()

		TweenService:Create(
			Button,
			TweenInfo.new(0.12),
			{BackgroundColor3 = COLORS.CardHover}
		):Play()

		TweenService:Create(
			Arrow,
			TweenInfo.new(0.12),
			{TextColor3 = COLORS.Accent}
		):Play()

	end)

	Button.MouseLeave:Connect(function()

		TweenService:Create(
			Button,
			TweenInfo.new(0.12),
			{BackgroundColor3 = COLORS.Card}
		):Play()

		TweenService:Create(
			Arrow,
			TweenInfo.new(0.12),
			{TextColor3 = Color3.fromRGB(100, 103, 115)}
		):Play()

	end)

	-- Tıklama
	Button.MouseButton1Click:Connect(function()

		local ProfileURL =
			"https://www.roblox.com/users/"
			.. tostring(Player.UserId)
			.. "/profile"

		ProfileTitle.Text = Player.DisplayName .. " • Profile"
		URLBox.Text = ProfileURL
		ProfileFrame.Visible = true

		task.defer(function()

			URLBox:CaptureFocus()

			URLBox.SelectionStart = 1
			URLBox.CursorPosition = #ProfileURL + 1

		end)

	end)

end

--==================================================
-- REMOVE PLAYER
--==================================================

local function RemovePlayer(Player)

	local Button = List:FindFirstChild("Player_" .. Player.UserId)

	if Button then
		Button:Destroy()
	end

end

--==================================================
-- COUNT
--==================================================

local function UpdateCount()

	local Amount = #Players:GetPlayers()

	if Amount == 1 then
		Count.Text = "1 player online"
	else
		Count.Text = tostring(Amount) .. " players online"
	end

end

--==================================================
-- INITIALIZE
--==================================================

for _, Player in ipairs(Players:GetPlayers()) do
	CreatePlayerButton(Player)
end

UpdateCount()

--==================================================
-- PLAYER JOIN
--==================================================

Players.PlayerAdded:Connect(function(Player)

	CreatePlayerButton(Player)
	UpdateCount()

end)

--==================================================
-- PLAYER LEAVE
--==================================================

Players.PlayerRemoving:Connect(function(Player)

	RemovePlayer(Player)
	UpdateCount()

end)

--==================================================
-- OPEN / CLOSE
--==================================================

local function ShowMain()

	Main.Visible = true

	Main.Position = UDim2.new(1, -350, 0, 75)

	TweenService:Create(
		Main,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(1, -370, 0, 75)
		}
	):Play()

end

local function HideMain()

	TweenService:Create(
		Main,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),
		{
			Position = UDim2.new(1, -350, 0, 75)
		}
	):Play()

	task.delay(0.15, function()

		Main.Visible = false

	end)

end

OpenButton.MouseButton1Click:Connect(function()

	if Main.Visible then
		HideMain()
	else
		ShowMain()
	end

end)

Close.MouseButton1Click:Connect(function()
	HideMain()
end)

